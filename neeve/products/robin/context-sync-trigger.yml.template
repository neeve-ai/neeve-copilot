name: Neeve Context Sync

# Thin trigger — this file is the only thing committed by hand into each
# product repo. It never contains actual content, so it essentially never
# goes stale; all real content generation happens in context-sync.reusable.yml
# over in neeve-copilot. Fires once a PR is actually merged to this repo's
# main branch (merging shows up as a push to main).

on:
  push:
    branches:
      - main

jobs:
  sync:
    uses: neeve-ai/neeve-copilot/.github/workflows/context-sync.reusable.yml@main
    with:
      repo: __REPO_NAME__
